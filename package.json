{
  "name": "skybook-qc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "user:create": "tsx --conditions=react-server scripts/create-user.ts",
    "company:grant": "tsx --conditions=react-server scripts/grant-company.ts",
    "qc:cleanup": "tsx --conditions=react-server scripts/qc-cleanup.ts",
    "qc:worker": "tsx --conditions=react-server scripts/qc-worker.ts",
    "qc:smoke:google": "tsx --conditions=react-server scripts/qc-smoke-google.ts",
    "qc:local:check": "tsx --conditions=react-server scripts/qc-local-check.ts",
    "qc:smoke:local": "tsx --conditions=react-server scripts/qc-smoke-local.ts",
    "qc:smoke:gemini": "tsx --conditions=react-server scripts/qc-smoke-gemini.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.38.0",
    "mupdf": "^1.28.1",
    "next": "16.3.4",
    "onnxruntime-node": "1.30.0",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.9",
    "ppu-paddle-ocr": "6.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.1.1",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
