# Skybook AI QC — environment variables
#
# Put these settings in <home>/.skybook-qc/.env.local — OUTSIDE the project folder,
# because the project is synced by OneDrive (on this PC: C:\Users\user\.skybook-qc\.env.local).
# The app and the npm scripts read that file automatically (src/lib/external-env.ts).
# A project .env.local also works and takes priority, but don't keep secrets in a synced folder.
# .env* files are git-ignored: never commit real secrets.
#
# Rule: only variables starting with NEXT_PUBLIC_ are sent to the browser.
# Secrets (keys, passwords, database URLs) must NEVER start with NEXT_PUBLIC_.

# ---------------------------------------------------------------
# Phase 1 — foundation (used now)
# ---------------------------------------------------------------

# Largest file a designer may upload, in megabytes.
# Anything that isn't a positive whole number falls back to 25.
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------
# Phase 2 — database and sign-in (used now)
# ---------------------------------------------------------------

# Skybook AI QC's own Supabase PostgreSQL database (D1). Server only.
# Supabase dashboard → Connect → copy a PostgreSQL connection string and
# put the database password in it. Either of these works:
#   Session pooler     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction pooler postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Add ?sslmode=require to the end (or &sslmode=require after other options).
# A remote database is ALWAYS encrypted: with no sslmode the app uses TLS anyway,
# and sslmode=disable / allow / prefer is refused (the app won't connect).
# Stores only users (with sign-in sessions) and, from Phase 3, company
# information. Never QC content.
# Without it the app still starts, but nobody can sign in.
DATABASE_URL=

# Optional: how many database connections the app may hold open (1–20).
# Default 5. Lower it if your Supabase plan or host limits connections.
# DATABASE_POOL_MAX=5

# The sign-in cookie holds a random token; nothing needs a signing secret.

# ---------------------------------------------------------------
# Phase 3.5 — company logos in Supabase Storage (D3). Server only.
# ---------------------------------------------------------------

# Supabase dashboard → Project Settings → API.
#   SUPABASE_URL: the project URL, e.g. https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY: the service_role (secret) key. It bypasses
#   Supabase's own access rules, so it must stay on the server:
#   never NEXT_PUBLIC_, never in browser code, never committed.
# Without these the app works, but logos can't be uploaded or shown.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The private bucket for logos. Created by `npm run db:migrate` on Supabase.
# SUPABASE_LOGO_BUCKET=company-logos

# Phase 4 — the private TEMPORARY bucket for QC session files (D11), deleted
# 24 hours after a session's last change. Created by `npm run db:migrate`.
# SUPABASE_QC_BUCKET=qc-temp-files

# Note: SUPABASE_URL must be the bare project address, e.g. https://abcd1234.supabase.co
# (no /rest/v1 on the end).

# ---------------------------------------------------------------
# Later phases — listed so you know what is coming. Leave blank for now.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Phase 6 — content analysis (D5 / D6 / D10). Server only. See docs/PHASE-6.md.
# ---------------------------------------------------------------

# mock = clearly labelled sample data ("Sample data — not real AI"); local = Local AI on this server;
# google = optional / future cloud analysis.
# Unset = analysis off (checks that need it show as not verified).
# The worker must run too: npm run qc:worker
# QC_ANALYSIS_PROVIDER=mock
# QC_MOCK_DELAY_MS=400

# Gemini API (QC_ANALYSIS_PROVIDER=gemini) — Google AI Studio key, one call per design,
# static designs only, no billing setup. See docs/GEMINI.md (free-tier data use, no EU region).
# Keep the key in <home>/.skybook-qc/.env.local, never in the project folder.
# GEMINI_API_KEY=
# QC_GEMINI_MODEL=gemini-3.8-flash

# Local AI (QC_ANALYSIS_PROVIDER=local) — everything on this server, no API calls. See docs/LOCAL-AI.md.
# cpu = testing only (minutes per design); gpu = production target.
# Ollama must listen on loopback only (OLLAMA_HOST=127.0.0.1:11434, OLLAMA_NO_CLOUD=1).
# QC_LOCAL_PROFILE=cpu
# QC_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
# QC_LOCAL_VISION_MODEL=qwen3-vl:4b-instruct
# QC_LOCAL_MODELS_DIR=C:/skybook-qc-local-models
# QC_LOCAL_WHISPER_BIN=C:/skybook-qc-local-models/whisper/bin/whisper-cli.exe
# QC_LOCAL_WHISPER_MODEL=ggml-base.en.bin
# QC_LOCAL_THREADS=4
# QC_LOCAL_MIN_FREE_MB=512

# QC report (Phase 8): the time zone for the QC date on the PDF. Default Asia/Dubai.
# QC_REPORT_TIME_ZONE=Asia/Dubai

# Google Cloud (QC_ANALYSIS_PROVIDER=google) — optional / future. EU only — global and other regions are refused.
# Key file: keep it OUTSIDE the project folder (OneDrive), e.g. C:\Users\<you>\.skybook-qc\google-key.json
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=
# QC_GOOGLE_REGION=eu
# QC_GEMINI_MODEL=gemini-3.8-flash

# Optional: a system FFmpeg instead of the bundled one, and the worker's temp folder.
# FFMPEG_PATH=
# QC_WORKER_TEMP_DIR=
